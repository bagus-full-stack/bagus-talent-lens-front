# GEMINI_API_KEY: Requis pour les appels d'IA d'analyse de CV et d'aide à la décision.
# AI Studio injecte cette variable automatiquement au runtime.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL publique où l'application est hébergée.
APP_URL="http://localhost:3000"

# DATA_SOURCE: Couche d'accès aux données ('mock' pour mode démonstrateur hors-ligne / 'supabase' pour persistance réelle)
DATA_SOURCE="mock"

# NEXT_PUBLIC_SUPABASE_URL: URL de l'instance Supabase (client et serveur)
NEXT_PUBLIC_SUPABASE_URL="https://votre-projet.supabase.co"

# NEXT_PUBLIC_SUPABASE_ANON_KEY: Clé anonyme publique pour requêtes cliente avec Row Level Security (RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# SUPABASE_SERVICE_ROLE_KEY: Clé serveur SECRÈTE (JAMAIS préfixée par NEXT_PUBLIC_)
# Utilisée exclusivement côté serveur pour les purges WORM, vérifications DPO et synchronisations d'audit.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9_SECRET_SERVICE_ROLE..."

# POLITIQUE DE CONFIDENTIALITÉ & MODE AVEUGLE PAR DÉFAUT
# En conformité avec l'Art. 22 & 25 RGPD (Privacy by Design)
NEXT_PUBLIC_BLIND_MODE_DEFAULT="true"
